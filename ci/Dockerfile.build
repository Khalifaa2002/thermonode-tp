# Image de build/test reproductible (utilisée par tous les stages du pipeline et par le développeur)
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential gcc-arm-none-eabi binutils-arm-none-eabi cppcheck git \
      python3 python3-pip python3-venv make ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages --no-cache-dir gcovr==7.2 paho-mqtt==2.1.0 pytest==8.3.3 pytest-cov==5.0.0 pytest-timeout==2.3.1 pylint==3.3.1
RUN curl -fsSL -o /tmp/ss.zip https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-6.2.1.4610-linux-x64.zip \
    && unzip -q /tmp/ss.zip -d /opt && ln -s /opt/sonar-scanner-*/bin/sonar-scanner /usr/local/bin/sonar-scanner && rm /tmp/ss.zip
WORKDIR /work
LABEL org.opencontainers.image.title="thermonode-build" org.opencontainers.image.version="1.0"
